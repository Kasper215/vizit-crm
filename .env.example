NODE_ENV=development
HOST=127.0.0.1
PORT=4175
CRM_URL=http://127.0.0.1:4175
DATABASE_PATH=data/crm.sqlite

TELEGRAM_BOT_TOKEN=вставьте_токен_бота
TELEGRAM_ALLOWED_CHAT_ID=ID_рабочей_группы
TELEGRAM_ALLOWED_USER_IDS=ваш_Telegram_ID
TELEGRAM_TOPIC_MAP={"12345":"Бьюти","67890":"Рестораны"}
TELEGRAM_WEBAPP_URL=https://crm.example.ru/miniapp
CRM_API_TOKEN=сгенерируйте_отдельный_длинный_случайный_токен

TELEGRAM_DIGEST_TIME=09:00
TELEGRAM_TIMEZONE=Europe/Moscow

# Необязательно: расшифровка голоса. Если пусто, аудио хранится как файл без отправки внешнему провайдеру.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
